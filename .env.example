DATABASE_URL=postgresql://user:password@localhost:5432/micolegio
JWT_SECRET=changeme-set-JWT_SECRET-in-env
PORT=3000

# ── Almacenamiento de documentos de inscripción/matrícula ──────────────────
# STORAGE_DRIVER=local (por defecto) | s3 | azure | vercel-blob

# local (por defecto): guarda los archivos en disco
# LOCAL_STORAGE_PATH=/ruta/absoluta/opcional   # por defecto: <cwd>/uploads/enrollment

# s3: requiere S3_BUCKET y S3_REGION
# S3_BUCKET=mi-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...            # opcional si se usa un rol IAM
# S3_SECRET_ACCESS_KEY=...        # opcional si se usa un rol IAM
# S3_ENDPOINT=https://...         # opcional, para S3-compatibles (MinIO, R2, Spaces)
# S3_FORCE_PATH_STYLE=true        # opcional, requerido por algunos S3-compatibles
# S3_PREFIX=enrollment            # opcional, prefijo dentro del bucket

# azure: requiere AZURE_STORAGE_CONNECTION_STRING y AZURE_STORAGE_CONTAINER
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=enrollment-docs
# AZURE_STORAGE_PREFIX=enrollment # opcional, prefijo dentro del contenedor

# vercel-blob: requiere BLOB_READ_WRITE_TOKEN (se inyecta solo al desplegar en Vercel
# con un Blob Store conectado al proyecto; en otros entornos cópialo desde el dashboard
# de Vercel > Storage > tu Blob Store > ".env.local"). Los archivos se guardan con
# acceso 'private' (requieren el token para leerse, no son URLs públicas).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# VERCEL_BLOB_PREFIX=enrollment    # opcional, prefijo dentro del store
